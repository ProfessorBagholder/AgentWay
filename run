#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")"
port=8787
open_browser=true
share=false
bridge_port=8788
while (($#)); do
  case "$1" in
    --port) [[ $# -ge 2 ]] || { echo 'Missing port' >&2; exit 2; }; port="$2"; shift 2 ;;
    --share) share=true; shift ;;
    --bridge-port) [[ $# -ge 2 ]] || { echo 'Missing bridge port' >&2; exit 2; }; bridge_port="$2"; shift 2 ;;
    --no-open) open_browser=false; shift ;;
    *) echo "Usage: ./run [--port PORT] [--bridge-port PORT] [--share] [--no-open]" >&2; exit 2 ;;
  esac
done
[[ "$port" =~ ^[0-9]+$ && ${#port} -le 5 ]] && ((10#$port > 1023 && 10#$port < 65536)) || { echo 'Port must be 1024–65535.' >&2; exit 2; }
[[ "$bridge_port" =~ ^[0-9]+$ && ${#bridge_port} -le 5 ]] && ((10#$bridge_port > 1023 && 10#$bridge_port < 65536 && 10#$bridge_port != 10#$port)) || { echo 'Bridge port must be 1024–65535 and different from the app port.' >&2; exit 2; }
command -v docker >/dev/null || { echo 'Install Docker with Compose, then run ./run again.' >&2; exit 1; }
docker compose version >/dev/null
docker info >/dev/null 2>&1 || { echo 'Start your Docker engine, then run ./run again.' >&2; exit 1; }
export AGENTWAY_PORT="$port"
export AGENTWAY_BRIDGE_PORT="$bridge_port"
url="http://127.0.0.1:$port"
compose=(docker compose -f compose.yaml)
named_tunnel=false
if [[ -e .agentway/tunnel-hostname || -e .agentway/tunnel-token ]]; then
  [[ -s .agentway/tunnel-hostname && -s .agentway/tunnel-token ]] || { echo 'Named tunnel setup is incomplete: both .agentway/tunnel-hostname and .agentway/tunnel-token are required.' >&2; exit 1; }
  tunnel_hostname=$(cat .agentway/tunnel-hostname)
  [[ "$tunnel_hostname" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ && "$tunnel_hostname" == *.* && "$tunnel_hostname" != *..* ]] || { echo 'Invalid named tunnel hostname.' >&2; exit 1; }
  command -v curl >/dev/null || { echo 'curl is required to check the named tunnel.' >&2; exit 1; }
  export AGENTWAY_TUNNEL_UID="$(id -u)"
  export AGENTWAY_TUNNEL_GID="$(id -g)"
  compose+=(-f compose.named-tunnel.yaml --profile share)
  named_tunnel=true
fi
printf 'Building and starting AgentWay at %s…\n' "$url"
if ! "${compose[@]}" up --build --detach --wait --wait-timeout 120; then
  "${compose[@]}" logs --tail 60 >&2
  echo 'Startup failed. If the port is occupied, use ./run --port 8790. No other process was stopped.' >&2
  exit 1
fi
if "$named_tunnel"; then
  tunnel_url="https://$tunnel_hostname"
  reachable=false
  response_file=$(mktemp)
  trap 'rm -f "$response_file"' EXIT
  printf 'Checking agent endpoint: %s…\n' "$tunnel_url"
  for attempt in {1..30}; do
    status=$(curl --silent --max-time 5 --output "$response_file" --write-out '%{http_code}' "$tunnel_url/v1/status") || status=000
    if [[ "$status" == 401 ]] && grep -q 'AgentWay bearer token required' "$response_file"; then
      reachable=true
      break
    fi
    sleep 2
  done
  "$reachable" || { echo 'The app is running, but the named tunnel is not reachable. Check docker compose logs tunnel; the previous saved agent endpoint was preserved.' >&2; exit 1; }
  curl --fail --silent --show-error --max-time 10 -H 'Content-Type: application/json' --data "{\"url\":\"$tunnel_url\"}" "$url/api/publishing/bridge" >/dev/null
  printf 'Agent endpoint: %s (authenticated; stable address)\n' "$tunnel_url"
elif "$share"; then
  command -v curl >/dev/null || { echo 'curl is required to configure the tunnel address.' >&2; exit 1; }
  docker compose --profile share up --detach --force-recreate tunnel
  tunnel_url=""
  for attempt in {1..30}; do
    tunnel_url=$(docker compose logs --no-color tunnel 2>&1 | sed -nE 's/.*(https:\/\/[a-z0-9-]+\.trycloudflare\.com).*/\1/p' | tail -1)
    [[ -n "$tunnel_url" ]] && break
    sleep 1
  done
  [[ -n "$tunnel_url" ]] || { echo 'Tunnel did not start. See docker compose logs tunnel.' >&2; exit 1; }
  curl --fail --silent --show-error -H 'Content-Type: application/json' --data "{\"url\":\"$tunnel_url\"}" "$url/api/publishing/bridge" >/dev/null
  printf 'Agent endpoint: %s (authenticated; temporary address)\n' "$tunnel_url"
fi
printf '\nAgentWay is ready: %s\nStop: ./stop   Logs: docker compose logs -f\n' "$url"
if "$open_browser"; then
  case "$(uname -s)" in
    Darwin) open "$url" || printf 'Open %s in your browser.\n' "$url" ;;
    Linux) if command -v xdg-open >/dev/null && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then xdg-open "$url" >/dev/null 2>&1 || true; fi ;;
  esac
fi
